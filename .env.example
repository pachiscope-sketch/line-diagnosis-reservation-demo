# LINE Developersで作成したLIFF IDを設定します。
# 未設定の場合、このデモはモックモードで動きます。
NEXT_PUBLIC_LIFF_ID=

# VercelやLINE Developersに登録する本番URLです。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# trueにするとLIFF IDや外部連携があってもブラウザ確認用のモック動作を優先できます。
NEXT_PUBLIC_USE_MOCK=true

# 旧設定名も互換用に残しています。新規設定では NEXT_PUBLIC_USE_MOCK を使ってください。
NEXT_PUBLIC_DEMO_MODE=false

# Supabase設定。未設定の場合はローカルストレージとモックデータで動作します。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Slack Incoming Webhook URLを設定すると /api/notify から通知できます。
# 未設定の場合はconsole.logでモック通知します。
SLACK_WEBHOOK_URL=

# /admin と /staff の公開デモ用簡易パスワード認証。
# 未設定の場合はポートフォリオデモとして従来通り表示します。
ADMIN_PASSWORD=

# Google Sheets連携を追加する場合の設定例です。
# 本デモではTODOとしてAPIルート内に拡張ポイントを残しています。
GOOGLE_SHEETS_SPREADSHEET_ID=
